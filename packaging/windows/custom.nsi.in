!define MUI_WELCOMEPAGE_TITLE_3LINES
!define MUI_CUSTOMFUNCTION_GUIINIT check_x64

Function check_x64
  StrCmp "@CMAKE_SIZEOF_VOID_P@" "8" 0 +5
    StrCmp "$PROGRAMFILES32" "$PROGRAMFILES64" 0 +3
      MessageBox MB_ICONEXCLAMATION|MB_OK "The x64 package cannot be installed on a x32 Windows system. Installation aborted." /SD IDOK
      Abort
    ClearErrors
FunctionEnd


!define SHCNE_ASSOCCHANGED 0x8000000
!define SHCNF_IDLIST 0

!include "LogicLib.nsh"

; foom: A file type which another program has is taken, and that program is
; remembered, so that uninstalling gives the type back to it.
!macro TakeFileType EXT
  ReadRegStr $R0 HKLM "Software\Classes\${EXT}" ""
  ${If} $R0 != ""
  ${AndIf} $R0 != "FOOM.Map"
    WriteRegStr HKLM "Software\Classes\FOOM.Map\Previous" "${EXT}" "$R0"
  ${EndIf}
  WriteRegStr HKLM "Software\Classes\${EXT}" "" "FOOM.Map"
  WriteRegStr HKLM "Software\Classes\${EXT}" "PerceivedType" "document"
!macroend

; foom: Gives a file type back to the program which had it, if that program is
; still registered. Without one, the type is removed.
!macro ReturnFileType EXT
  ReadRegStr $R0 HKLM "Software\Classes\${EXT}" ""
  ${If} $R0 == "FOOM.Map"
    ReadRegStr $R1 HKLM "Software\Classes\FOOM.Map\Previous" "${EXT}"
    StrCpy $R2 ""
    ${If} $R1 != ""
      ReadRegStr $R2 HKLM "Software\Classes\$R1\shell\open\command" ""
    ${EndIf}
    ${If} $R2 != ""
      WriteRegStr HKLM "Software\Classes\${EXT}" "" "$R1"
    ${Else}
      DeleteRegKey HKLM "Software\Classes\${EXT}"
    ${EndIf}
  ${EndIf}
!macroend

Function installAssociations
  ; The application
  WriteRegStr HKLM "Software\Classes\FOOM.Map" "" "FOOM Map"
  WriteRegStr HKLM "Software\Classes\FOOM.Map\DefaultIcon" "" "$INSTDIR\FOOM.exe"
  
  ReadRegStr $R0 HKLM "Software\Classes\FOOM.Map\shell\open\command" ""
  StrCmp $R0 "" 0 +3
    WriteRegStr HKLM "Software\Classes\FOOM.Map\shell" "" "open"
    WriteRegStr HKLM "Software\Classes\FOOM.Map\shell\open\command" "" '"$INSTDIR\FOOM.exe" "%1"'
  
  ; The file type associations
  !insertmacro TakeFileType ".foom"
  !insertmacro TakeFileType ".omap"
  !insertmacro TakeFileType ".xmap"
  
  ReadRegStr $R0 HKLM "Software\Classes\.ocd" ""
  StrCmp $R0 "" 0 +3
    WriteRegStr HKLM "Software\Classes\.ocd" "" "FOOM.Map"
    WriteRegStr HKLM "Software\Classes\.ocd" "PerceivedType" "document"
  WriteRegStr HKLM "Software\Classes\.ocd\OpenWithProgIDs" "FOOM.Map" ""
  
  System::Call 'Shell32::SHChangeNotify(i ${SHCNE_ASSOCCHANGED}, i ${SHCNF_IDLIST}, p0, p0)'
FunctionEnd

Function un.installAssociations
  ; The file type associations
  !insertmacro ReturnFileType ".foom"
  !insertmacro ReturnFileType ".omap"
  !insertmacro ReturnFileType ".xmap"
  
  DeleteRegValue HKLM "Software\Classes\.ocd\OpenWithProgIDs" "FOOM.Map"
  ReadRegStr $R0 HKLM "Software\Classes\.ocd" ""
  StrCmp $R0 "FOOM.Map" 0 +2
    DeleteRegKey HKLM "Software\Classes\.ocd"
  
  ; The application
  DeleteRegKey HKLM "Software\Classes\FOOM.Map"
  
  System::Call 'Shell32::SHChangeNotify(i ${SHCNE_ASSOCCHANGED}, i ${SHCNF_IDLIST}, p0, p0)'
FunctionEnd

